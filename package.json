    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "next-cloudinary": "^6.17.5",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
