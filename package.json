    "test": "npm run test:links && npm run test:stock && npm run test:payments && npm run test:deal-archive && npm run test:export-api && npm run test:media && npm run test:pallet && npm run test:recovery && npm run test:price-calc && npm run test:prices && npm run test:price-list && npm run test:tax && npm run test:assembly && npm run test:assembly-api && npm run test:color-twin && npm run test:color-twin-api && npm run test:local-db && npm run test:login-http && npm run test:full-backup && npm run test:pc-schedule && npm run test:merge-backup && npm run test:pc-incremental && npm run test:pc-working && npm run test:pc-local && npm run test:pc-working-live && npm run test:pc-working-live-http && npm run test:pc-reconcile-primitives && npm run test:home-empty && npm run test:admin-backup-display",
    "test:home-empty": "node --test tests/home-empty-state-http.test.mjs",
    "test:recovery": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/admin-recovery.test.mjs",
    "test:full-backup": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/full-backup.test.mjs",
    "test:login-http": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/admin-login-http.test.mjs",
    "test:price-calc": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/price-calc.test.mjs",
    "test:price-list": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/price-list.test.mjs",
    "test:tax": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/tax-calc.test.mjs",
    "test:prices": "node --experimental-strip-types --import ./tests/api-prices-register.mjs --test tests/api-bulk-prices.test.mjs",
    "dev:plain": "next dev",
    "test:pallet": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/pallet.test.mjs",
    "test:pc-schedule": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/pc-scheduled-backup.test.mjs",
    "test:merge-backup": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/merge-public-snapshots.test.mjs",
    "test:pc-incremental": "node --experimental-strip-types --import ./tests/ts-register.mjs --test tests/pc-incremental-sql.test.mjs tests/pc-incremental-client.test.mjs tests/pc-live-backup.test.mjs tests/pc-download-backup.test.mjs",
