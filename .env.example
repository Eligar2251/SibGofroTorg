# Единый шаблон. Заполните свои значения в .env или .env.local на сервере.
# Не публикуйте и не коммитьте реальные ключи. После изменений окружения
# перезапустите приложение (NEXT_PUBLIC_* в Docker задаются при сборке).

# 1. Официальный Supabase Cloud (Европа). Оставлены имена из вашего .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# Альтернативные названия тех же ключей (не заполняйте одновременно с разными значениями):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# 2. Самостоятельно установленный Supabase на VPS: URL его API gateway
# (не строка PostgreSQL). Нужны его СОБСТВЕННЫЕ ключи; legacy JWT тоже подходят.
SUPABASE_SECONDARY_URL=
SUPABASE_SECONDARY_PUBLISHABLE_KEY=
SUPABASE_SECONDARY_SECRET_KEY=
# Альтернативы: SUPABASE_SECONDARY_ANON_KEY и SUPABASE_SECONDARY_SERVICE_ROLE_KEY
SUPABASE_FETCH_TIMEOUT_MS=8000

# 3. Рабочая локальная JSON-БД: файл local-db.json внутри этой папки.
# Это путь на машине, ГДЕ ЗАПУЩЕН САЙТ, не на произвольном ПК в браузере.
# На Docker используйте постоянный volume; для диска ПК нужен доступный серверу mount.
SGT_DATA_DIR=./.sgt-data
SGT_BACKUP_DIR=./.sgt-data/backups
SGT_AUTO_BACKUP_INTERVAL_SEC=150
# SGT_LOCAL_DB_SECRET_KEY=

# 4. Безопасность (используйте свои действующие секреты, минимум 32 символа)
ADMIN_SECRET_PATH=YOUR_SECRET_ADMIN_PATH
NEXT_PUBLIC_ADMIN_PATH=YOUR_SECRET_ADMIN_PATH
ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_ADMIN_SESSION_SECRET
USER_SESSION_SECRET=YOUR_LONG_RANDOM_USER_SESSION_SECRET
# ADMIN_RECOVERY_TOKEN=

# 5. Контакты и сайт
NEXT_PUBLIC_SITE_URL=https://sibgofrotorg.ru
NEXT_PUBLIC_COMPANY_ADDRESS="г. Новосибирск, ул. Ватутина, 42а к1"
NEXT_PUBLIC_COMPANY_PHONE="+7 (383) 291-81-46"
NEXT_PUBLIC_COMPANY_HOURS_WEEKDAY="9:00–17:00"
NEXT_PUBLIC_COMPANY_HOURS_SATURDAY="10:00–15:00"
NEXT_PUBLIC_COMPANY_EMAIL=sk2-tdstm@mail.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_EMERGENCY_BANNER=1

# 6. Cloudinary и Telegram (вставьте свои действующие значения)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# 7. HTTP
PORT=3000
HOSTNAME=0.0.0.0
