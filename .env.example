# ==============================================================================
# SibGofroTorg — Шаблон файла переменных окружения (.env)
# Скопируйте этот файл в `.env` (или `.env.local`) в корне проекта:
#   cp .env.example .env
#
# ВАЖНО: Никогда не коммитьте реальный файл `.env` в Git!
# Проект поддерживает КАК НОВЫЕ ключи Supabase (Publishable key / Secret key),
# ТАК И старые Legacy JWT-ключи (anon / service_role).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОСНОВНАЯ БАЗА ДАННЫХ SUPABASE (Новый формат ключей Supabase Dashboard)
# Где взять в панели Supabase:
#   Project Settings (шестерёнка) → API Keys (или Connect → App Frameworks)
# ------------------------------------------------------------------------------

# Project URL (например: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://ВАШ_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ_PROJECT_REF.supabase.co

# Publishable key (публичный ключ для браузера, начинается с `sb_publishable_...`)
# Заменяет старый `anon` ключ и работает строго по правилам RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ВСТАВЬТЕ_СЮДА_PUBLISHABLE_KEY

# Secret key (секретный серверный ключ, начинается с `sb_secret_...`)
# Заменяет старый `service_role` ключ. НИКОГДА не добавляйте к нему NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=sb_secret_ВСТАВЬТЕ_СЮДА_SECRET_KEY

# (Опционально) Для обратной совместимости можно продублировать или использовать
# старые имена переменных — сервер автоматически понимает оба варианта:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ВСТАВЬТЕ_СЮДА_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_ВСТАВЬТЕ_СЮДА_SECRET_KEY

# Таймаут запросов к Supabase в мс (при недоступности сервер переключается на локальную БД)
SUPABASE_FETCH_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 2. РЕЗЕРВНЫЙ SUPABASE #2 (необязательно — можно также задать прямо в Админке)
# ------------------------------------------------------------------------------
# SUPABASE_SECONDARY_URL=
# SUPABASE_SECONDARY_PUBLISHABLE_KEY=
# SUPABASE_SECONDARY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. БЕЗОПАСНОСТЬ СЕССИЙ И АДМИН-ПАНЕЛИ
# ------------------------------------------------------------------------------

# Секрет подписи сессий администраторов (ОБЯЗАТЕЛЬНО в production, минимум 32 символа!)
# Сгенерировать случайную строку: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=замените_на_случайную_строку_длиной_от_32_символов_минимум

# Секрет подписи сессий клиентов личного кабинета (если не задан — берётся ADMIN_SESSION_SECRET)
USER_SESSION_SECRET=замените_на_другую_случайную_строку_от_32_символов

# Секретный URL-путь входа в админ-панель (по умолчанию `/admin`, лучше заменить на свой!)
# Оба значения должны совпадать (без начального слэша или с ним, например `sgt-control-2026`):
NEXT_PUBLIC_ADMIN_PATH=admin
ADMIN_SECRET_PATH=admin

# Временный токен аварийного создания/сброса владельца через POST /api/health/recover-admin
# Оставьте пустым после первоначального создания аккаунта owner!
# ADMIN_RECOVERY_TOKEN=

# ------------------------------------------------------------------------------
# 4. АВТОНОМНАЯ ЛОКАЛЬНАЯ JSON-БАЗА И АВТОБЭКАП НА ДИСК (каждые 2–3 минуты)
# ------------------------------------------------------------------------------

# Папка хранения рабочей локальной JSON-БД и runtime-настроек (по умолчанию ./.sgt-data)
SGT_DATA_DIR=./.sgt-data

# Папка автоматических резервных копий на диске сервера / ПК (по умолчанию ./.sgt-data/backups)
# На Windows можно указать, например: D:/SibGofroTorgBackups
# На Linux VPS можно указать, например: /var/backups/sibgofrotorg
SGT_BACKUP_DIR=./.sgt-data/backups

# Интервал автоматического сохранения снимка БД на диск в секундах (120–180 сек = 2–3 мин)
SGT_AUTO_BACKUP_INTERVAL_SEC=150

# Мастер-ключ для вычисления секретного кода входа по локальному файлу БД (необязательно)
# SGT_LOCAL_DB_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. САЙТ, БАННЕР АВАРИЙНОГО РЕЖИМА И КОНТАКТЫ
# ------------------------------------------------------------------------------

# Публичный адрес сайта (для SEO, sitemap и ссылок)
NEXT_PUBLIC_SITE_URL=https://sibgofrotorg.ru

# Аварийный баннер о проблемах в ДЦ Beget (`1` = показывать, `0` = скрыть когда всё восстановят)
NEXT_PUBLIC_EMERGENCY_BANNER=1

# Контакты компании в шапке и подвале (необязательно — есть встроенные значения по умолчанию)
NEXT_PUBLIC_COMPANY_EMAIL=sk2-tdstm@mail.ru
# NEXT_PUBLIC_COMPANY_ADDRESS=г. Новосибирск, ул. Станционная, 30а
# NEXT_PUBLIC_COMPANY_HOURS_WEEKDAY=Пн–Пт: 9:00–18:00

# ID счётчика Яндекс.Метрики (необязательно)
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ------------------------------------------------------------------------------
# 6. ОБЛАЧНОЕ ХРАНИЛИЩЕ КАРТИНОК CLOUDINARY (необязательно)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. ПАРАМЕТРЫ HTTP-СЕРВЕРА NEXT.JS (для запуска standalone / Docker / VPS)
# ------------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
